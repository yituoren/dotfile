// Outputs
//
// The refresh rate must match the advertised mode exactly, including fractions such as
//   144.000 or 143.998. Read the exact mode with niri msg outputs and enter it below.
//   niri falls back to the preferred mode if the configured one is unavailable.

output "eDP-1" {
    mode "2560x1600@144.000"
    scale 1
    position x=0 y=0
    variable-refresh-rate       // = vrr = 1
}

output "DP-2" {
    mode "2560x1440@144.000"
    scale 1
    position x=2560 y=0
    variable-refresh-rate
}
