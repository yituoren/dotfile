// niri configuration entry point
// Top-level includes group settings by function (niri 26.04+).
// Documentation: https://yalter.github.io/niri/ . Saving a file reloads the configuration.
//
// Include resolution:
//   - Paths are relative to this file in ~/.config/niri/.
//   - Sections merge in include order. Later settings take precedence.
//   - Includes belong at the top level, outside blocks such as layout {}.

include "environment.kdl"   // Environment
include "input.kdl"         // Keyboard, touchpad and mouse
include "outputs.kdl"       // Outputs
include "layout.kdl"        // Layout, gaps, shadows and blur
include "startup.kdl"       // Startup, cursor and miscellaneous settings
include "rules.kdl"         // Window and layer rules
include "binds.kdl"         // Key bindings
