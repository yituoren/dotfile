// Input devices

input {
    keyboard {
        xkb {
            layout "us"
        }
        // Equivalent to repeat_delay and repeat_rate
        repeat-delay 250
        repeat-rate 35
        // Equivalent to numlock_by_default
        numlock
    }

    touchpad {
        tap
        natural-scroll          // = natural_scroll
        dwt                     // = disable_while_typing
        click-method "clickfinger"   // = clickfinger_behavior
        scroll-factor 0.7       // = scroll_factor
    }

    mouse {}

}
