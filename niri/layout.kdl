// Layout, gaps, shadows and blur

layout {
    // Global gap between windows, exclusive regions and workspace struts.
    // Match the bar's 8 px margins for consistent spacing.
    gaps 8

    center-focused-column "never"

    // Cycle through preset column width proportions in the scrolling layout.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // Focus ring
    // The color is fixed here. To generate it with matugen, render a fragment containing
    //   layout { focus-ring { active-color "..." } } and include it from config.kdl.
    //   niri merges the layout sections.
    focus-ring {
        width 2
        active-color "#00000000"
        inactive-color "#00000000"
    }

    // niri draws borders inside the window and the focus ring outside.
    border {
        off
    }

    // Equivalent to decoration { shadow {} }
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000040"
    }

    // Screen-edge reservations:
    //   61 px at the top reserves space for the bar. The fullscreen ContentWindow uses
    //               WlrLayershell.exclusionMode=Ignore and publishes no exclusive_zone.
    //               The strut covers the 8 px top margin and the 53 px bar.
    //   Zero struts on the other edges leave the normal 8 px gap.
    struts {
        top 61
        left 0
        right 0
        bottom 0
    }
}

// Blur
// The global blur block configures the effect. Enable it in rules.kdl with background-effect
// or let a translucent application request it through ext-background-effect.
blur {
    passes 3            // More passes soften the blur and cost more GPU time.
    offset 3.0          // Larger sampling offsets soften the blur at little extra cost.
    noise 0.04          // Reduce banding.
    saturation 1.3      // Blurred background saturation (values above 1 boost color).
    // off               // Uncomment to disable blur globally.
}
