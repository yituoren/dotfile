// Environment variables
// Values in environment {} are literal. Use absolute paths for $HOME and other variables.

environment {
    // Include ~/.local/bin in PATH so niri can spawn user-installed commands
    // such as zed and setwall. The literal PATH needs the absolute directory name.
    PATH "/home/yituoren/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"

    // Fcitx5 input method
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
    SDL_IM_MODULE "fcitx"
    GLFW_IM_MODULE "ibus"
    INPUT_METHOD "fcitx"

    // Qt and theming
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "kde"
    XDG_MENU_PREFIX "plasma-"

    // QML search path for the user-installed Caelestia.Blobs SDF plugin
    // Qt searches /usr/lib/qt6/qml by default. Add ~/.local/share/qt6/qml explicitly.
    QML_IMPORT_PATH "/home/yituoren/.local/share/qt6/qml"
    QML2_IMPORT_PATH "/home/yituoren/.local/share/qt6/qml"

    // Miscellaneous
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    WEBKIT_DISABLE_COMPOSITING_MODE "1"
    TERMINAL "wezterm"
    ZED_ALLOW_EMULATED_GPU "1"

    // NVIDIA
    LIBVA_DRIVER_NAME "nvidia"
    __GLX_VENDOR_LIBRARY_NAME "nvidia"

}
