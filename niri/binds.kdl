// Mod defaults to Super in niri.

binds {
    // ---- Desktop ----
    Mod+Slash repeat=false hotkey-overlay-title="Keyboard shortcuts" { spawn-sh "qs -c mine ipc call desktop shortcuts || niri msg action show-hotkey-overlay"; }
    Mod+Space hotkey-overlay-title="Launch an application" { spawn "fuzzel"; }                      // Application launcher. niri requires a key in addition to the modifier.
    Mod+V hotkey-overlay-title="Clipboard history" { spawn-sh "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }  // Clipboard history
    Ctrl+Alt+Delete hotkey-overlay-title="Power menu" { spawn "qs" "-c" "mine" "ipc" "call" "power" "toggle"; }                     // Session menu

    // ---- Applications ----
    Mod+Return hotkey-overlay-title="Open WezTerm" { spawn "wezterm"; }
    Mod+T hotkey-overlay-title="Open Kitty" { spawn "kitty"; }
    Mod+W hotkey-overlay-title="Open Chrome" { spawn "google-chrome-stable"; }
    // Run the Yazi TUI in a terminal with the yazi app ID for window matching.
    Mod+E hotkey-overlay-title="Open Yazi in WezTerm" { spawn "wezterm" "start" "--class" "yazi" "--" "yazi"; }
    Mod+C hotkey-overlay-title="Open Zed" { spawn "zed"; }

    // ---- Windows ----
    Mod+Q           { close-window; }
    Alt+F4          { close-window; }

    // Focus columns horizontally or windows within a column vertically.
    Mod+Left        { focus-column-left; }
    Mod+Right       { focus-column-right; }
    Mod+Up          { focus-window-up; }
    Mod+Down        { focus-window-down; }

    // Move windows
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+D           { maximize-column; }
    Mod+F           { fullscreen-window; }
    Mod+Alt+Space   { toggle-window-floating; }

    // Column widths and window heights
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+R           { switch-preset-column-width; }   // Cycle through the preset column widths in layout.kdl.
    Mod+Shift+R     { switch-preset-window-height; }

    // Move windows into or out of the current scrolling column.
    Mod+Comma       { consume-window-into-column; }
    Mod+Period      { expel-window-from-column; }

    // ---- Workspaces ----
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    // Move to a workspace without focusing it.
    Mod+Shift+1 { move-column-to-workspace 1 focus=false; }
    Mod+Shift+2 { move-column-to-workspace 2 focus=false; }
    Mod+Shift+3 { move-column-to-workspace 3 focus=false; }
    Mod+Shift+4 { move-column-to-workspace 4 focus=false; }
    Mod+Shift+5 { move-column-to-workspace 5 focus=false; }
    Mod+Shift+6 { move-column-to-workspace 6 focus=false; }
    Mod+Shift+7 { move-column-to-workspace 7 focus=false; }
    Mod+Shift+8 { move-column-to-workspace 8 focus=false; }
    Mod+Shift+9 { move-column-to-workspace 9 focus=false; }
    Mod+Shift+0 { move-column-to-workspace 10 focus=false; }

    // Switch to an adjacent workspace.
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Page_Down      { focus-workspace-down; }
    Mod+BracketLeft    { focus-workspace-up; }
    Mod+BracketRight   { focus-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }

    // Switch workspaces with the mouse wheel.
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }

    // Overview
    Mod+Tab { toggle-overview; }

    // Vim bindings
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-workspace-up; }
    Mod+J { focus-workspace-down; }

    // ---- Displays ----
    Mod+Ctrl+Left   { focus-monitor-left; }
    Mod+Ctrl+Right  { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // ---- Capture ----
    Mod+Shift+S hotkey-overlay-title="Select a screenshot region" { screenshot; }            // Interactive region selection
    Print hotkey-overlay-title="Capture the screen" { screenshot-screen; }     // Capture the screen to the clipboard and a file.
    Mod+Alt+S hotkey-overlay-title="Capture the active window" { screenshot-window; }     // Capture the current window.
    Mod+Shift+C hotkey-overlay-title="Copy a screen color" { spawn-sh "color=$(niri msg pick-color | sed -n 's/^Hex: //p'); [ -z \"$color\" ] || printf %s \"$color\" | wl-copy"; }   // Copy the picked hex color.
    Mod+Shift+X repeat=false hotkey-overlay-title="Start or stop screen recording" { spawn-sh "exec ~/.dotfiles/scripts/toggle-recording.sh"; }

    // ---- Media ----
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Raise volume" { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.02+" "--limit" "1.5"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Lower volume" { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.02-"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Mute or unmute output" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Mute or unmute microphone" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Increase brightness" { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Decrease brightness" { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Play or pause" { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Next track" { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Previous track" { spawn "playerctl" "previous"; }

    // ---- Session ----
    Mod+Ctrl+L hotkey-overlay-title="Lock the session" { spawn "systemctl" "--user" "start" "mine-lock.service"; }
    Mod+Shift+L hotkey-overlay-title="Suspend" { spawn "systemctl" "suspend"; }       // Suspend
    Mod+Shift+E repeat=false hotkey-overlay-title="Log out of niri" { spawn-sh "qs -c mine ipc call desktop logout || niri msg action quit"; }

    // Saving a configuration file reloads niri automatically.
}
