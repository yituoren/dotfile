// Window and layer rules

// A window-rule without a match applies to every window.
// Translucent windows show the blurred background clipped to geometry-corner-radius.
window-rule {
    geometry-corner-radius 18
    clip-to-geometry true
    background-effect {
        blur true
    }
}

// Float small settings windows, including pavucontrol, nm-connection-editor and blueberry.
window-rule {
    match app-id="pavucontrol"
    match app-id="org.pulseaudio.pavucontrol"
    match app-id="nm-connection-editor"
    match app-id="blueberry"
    open-floating true
}

// Float the external Chrome chat window opened from the chat toolbar.
window-rule {
    match app-id=r#"^chrome-chatgpt\.com__-.+$"#
    open-floating true
    default-column-width { fixed 560; }
    default-window-height { proportion 0.78; }
    // 61 px to the bottom of the bar plus an 8 px gap.
    default-floating-position x=8 y=69 relative-to="top-left"
}

// Float picture-in-picture windows in the lower-right corner.
window-rule {
    match title="^Picture[-\\s]?in[-\\s]?Picture$"
    open-floating true
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

// Float file dialogs such as Open File and Save As.
// Match dialogs in two ways:
//   1. Portal file choosers run in separate windows
//      with the portal backend's app ID.
//   2. In-process GTK/Qt dialogs share their parent application's ID.
//      Match these by title using case-sensitive regular expressions.
//
// These IDs and titles follow common conventions. Titles also depend on the system language.
//   With the dialog open, run niri msg windows to inspect its app ID and title,
//   then adjust the match if necessary.
window-rule {
    // Portal file choosers
    match app-id="org.freedesktop.impl.portal.desktop.kde"
    // GTK/GNOME backend IDs follow the KDE naming convention and have not been verified.
    match app-id="org.freedesktop.impl.portal.desktop.gtk"
    match app-id="org.freedesktop.impl.portal.desktop.gnome"

    // Match by dialog title.
    match title="^Open File"
    match title="^Open Files"
    match title="^Open Folder"
    match title="^Save File"
    match title="^Save As"
    match title="^Select a File"
    match title="^Select Folder"
    match title="^Choose wallpaper"
    match title="^File Upload"
    match title="wants to save$"
    match title="wants to open$"

    open-floating true
}

// ============================================================
// Layer rules
// ============================================================

// Blur the background behind fuzzel.
// Fuzzel publishes the layer-shell namespace launcher.
// Match geometry-corner-radius to [border] radius in fuzzel.ini
// to keep the rectangular blur from showing outside the rounded corners.
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 17
    background-effect {
        blur true
    }
}

// The custom fullscreen ContentWindow uses the mine-shell namespace.
// The SDF draws the shape and rounded corners itself.
// The client supplies the animated blur region. Transparent pixels outside the bar
// and popups would otherwise receive blur across the entire output.
layer-rule {
    match namespace="^mine-shell$"
    background-effect {
        xray false
    }
}

// The chat panel has its own Quickshell layer surface.
layer-rule {
    match namespace="^mine-chat$"
    geometry-corner-radius 18
}
