// Startup, cursor and miscellaneous settings

// ---- Startup ----
// Input method
spawn-at-startup "fcitx5" "-d" "--replace"

// Wallpaper daemon. awww continues swww with awww img and awww restore.
spawn-at-startup "awww-daemon"
// Wait for an output and recover the saved matugen wallpaper path if the awww cache is empty after an upgrade.
spawn-sh-at-startup "bash ~/.dotfiles/scripts/restore-wallpaper.sh"

spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets"

// The session guard starts the idle monitors and handles logind lock requests.
spawn-at-startup "systemctl" "--user" "start" "mine-sleep-lock.service"

// Start EasyEffects with the session when installed.
spawn-sh-at-startup "if command -v easyeffects >/dev/null 2>&1; then exec easyeffects --service-mode; fi"

// Clipboard history using cliphist and a compositor-independent wl-paste watcher.
spawn-sh-at-startup "wl-paste --type text  --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"

// GeoClue location authorization for the weather panel.
spawn-at-startup "/usr/lib/geoclue-2.0/demos/agent"

// Start the custom shell from ~/.config/quickshell/mine, linked to ~/.dotfiles/quickshell/mine.
// niri/environment.kdl supplies QML_IMPORT_PATH so qs can find ~/.local/share/qt6/qml/Caelestia/Blobs.
// See docs/quickshell.md for building and installing the SDF plugin.
spawn-at-startup "qs" "-p" "/home/yituoren/.config/quickshell/mine" "-d"

// ---- Cursor ----
cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

// ---- Miscellaneous ----
prefer-no-csd                       // Request server-side decorations. niri does not draw title bars.
screenshot-path "~/Pictures/Screenshots/Screenshot-%Y%m%d-%H%M%S.png"

hotkey-overlay {
    skip-at-startup                  // Skip the hotkey overlay at startup.
}

gestures {
    hot-corners {
        off                          // Disable the overview hot corner to avoid accidental activation.
    }
}
